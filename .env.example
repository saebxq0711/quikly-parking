# =============================================================================
# Plataforma de Pago de Parqueaderos - variables de entorno
# Copiar a `.env` y rellenar. NUNCA commitear el archivo `.env`.
# =============================================================================

# --- Base de datos propia de la plataforma -----------------------------------
DATABASE_URL="postgresql://parking:parking@127.0.0.1:5433/parking_payments?schema=public"

# --- Sesiones ----------------------------------------------------------------
# Clave para firmar los JWT de sesion. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=""
# Duracion de la sesion en minutos. El punto de pago usa una mas corta (kiosco).
SESSION_TTL_MINUTES="480"

# --- Cifrado de credenciales en base de datos --------------------------------
# Clave AES-256-GCM (32 bytes en base64) para cifrar las credenciales de
# Redeban / SIIGO / Nova Parking guardadas en `integration_credentials`.
# Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Cambiarla invalida todos los secretos ya guardados: hay que volver a cargarlos.
CREDENTIALS_ENCRYPTION_KEY=""

# --- Integracion con el sistema de cada parqueadero --------------------------
# La URL del tunel y el token NO van aqui: son propios de cada parqueadero y se
# configuran desde la administracion (Parqueaderos -> ficha del sitio).
# Aqui solo queda el tiempo maximo de espera, que es comun.
NOVA_PARKING_TIMEOUT_MS="8000"

# --- SIIGO (facturacion electronica) -----------------------------------------
# Sandbox entregado por el cliente. Ver docs/ANALISIS_INTEGRACIONES.md.
SIIGO_API_URL="https://api.siigo.com"
SIIGO_USERNAME=""
SIIGO_ACCESS_KEY=""
# Cabecera obligatoria de identificacion del socio ante SIIGO.
SIIGO_PARTNER_ID="PuntoPagoParking"
# Habilita el envio real de facturas. En false solo se registra la intencion.
SIIGO_ENABLED="false"

# --- Redeban / SIPConnector --------------------------------------------------
# IMPORTANTE: esta plataforma NO habla directo con SIPConnector. El cobro lo
# ejecuta Nova Parking, que ya tiene el cliente construido y probado, y que es
# quien registra el movimiento en la caja. Enviar una segunda transaccion a la
# misma terminal produce `Cod:06 Ya existe una transaccion asignada a esta
# terminal` (Anexo 4 del manual SIPConnector V1.5) y descuadra los reportes.
# Estas variables existen solo para mostrar la configuracion en la UI del
# SuperAdmin y para el modo de contingencia documentado.
REDEBAN_DIRECT_MODE="false"
REDEBAN_BASE_URL="https://sipconnectortest.azurewebsites.net"
REDEBAN_CODIGO_UNICO=""
REDEBAN_USUARIO=""
REDEBAN_CLAVE=""
REDEBAN_CODIGO_TERMINAL=""
# Red que procesa el pago. 0 = Redeban (Anexo 5 del manual).
REDEBAN_RED="0"

# --- Aplicacion --------------------------------------------------------------
# URL publica de esta plataforma. Se usa para construir enlaces absolutos: los
# QR impresos, el enlace de la factura y los correos.
# En produccion es https://parking.quiklygo.com (si no se define, es lo que se
# asume). Nunca la direccion *.vercel.app: Chrome la bloquea.
APP_URL="http://127.0.0.1:3000"
NODE_ENV="development"

# Correo (recuperar contrasena y comprobantes).
# MAIL_FROM debe ser de un dominio VERIFICADO en Resend, y conviene que sea el
# mismo de la plataforma:
#   MAIL_FROM="Quikly Parking <no-responder@parking.quiklygo.com>"
RESEND_API_KEY=
MAIL_FROM=

# Tarea programada de Vercel que reintenta facturas pendientes (valor aleatorio largo).
CRON_SECRET=
